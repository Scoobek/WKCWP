# Sanity — fill these from https://www.sanity.io/manage after `npx sanity login`.
# Copy this file to `.env.local` and set the real values. `.env.local` is gitignored.

# Your Sanity project ID (Manage > Project > API).
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id

# Dataset to use. This project uses two datasets: `production` and `development`.
NEXT_PUBLIC_SANITY_DATASET=production

# API version, pinned to a date. Bump deliberately when adopting new API behavior.
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-12